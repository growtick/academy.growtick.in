---
import Base from '../../layouts/Base.astro';
import { serviceDb } from '../../lib/supabase';
import { one, batchWhen, batchWhere } from '../../lib/http';

const db = serviceDb();
const { reg_code } = Astro.params;

let batch: any = null;
let course: any = null;
let notFound = false;
let unconfigured = false;

if (db) {
  const { data: enr, error: enrError } = await db
    .from('academy_enrollments')
    .select('id, reg_code, academy_batches(kind, venue, address, starts_at, ends_at, fee, pay_on_spot, academy_courses(title, slug))')
    .eq('reg_code', reg_code ?? '')
    .maybeSingle();

  if (enrError || !enr) {
    notFound = true;
  } else {
    batch = one(enr.academy_batches);
    course = one(batch?.academy_courses);
  }
} else {
  unconfigured = true;
}
if (!notFound && !unconfigured && !course) notFound = true;

const gcal = (d?: string | null) => (d ? new Date(d).toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '') : '');
const calendarUrl =
  batch?.starts_at && course
    ? `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(course.title + ' (Growtick Academy)')}&dates=${gcal(batch.starts_at)}/${gcal(batch.ends_at ?? batch.starts_at)}&details=${encodeURIComponent('Registration code: ' + reg_code + '\nFee: ₹' + Number(batch.fee ?? 0) + (batch.pay_on_spot ? ', pay on arrival' : ''))}&location=${encodeURIComponent(batchWhere(batch))}`
    : 'https://calendar.google.com/';
---
<Base
  title={`Registration confirmed — ${course?.title ?? 'Growtick Academy'}`}
  description={course ? `Your registration for ${course.title} is confirmed. Registration code: ${reg_code}` : 'Registration confirmation'}
  noindex={true}
>
  {unconfigured ? (
    <section class="section">
      <div class="wrap">
        <div class="card">
          <p>Registrations are not configured yet. Please contact Growtick.</p>
        </div>
      </div>
    </section>
  ) : notFound ? (
    <section class="section">
      <div class="wrap">
        <div class="card">
          <h2>Registration not found</h2>
          <p>We couldn’t find a registration with code <strong>{reg_code}</strong>. Check the code in your confirmation email, or contact us on WhatsApp: <a href="https://wa.me/919513059059">+91 95130 59059</a>.</p>
          <a href="/" class="btn">Back to home</a>
        </div>
      </div>
    </section>
  ) : (
    <>
      <section class="section page-head">
        <div class="wrap">
          <p class="overline">Registration confirmed</p>
          <h1>You’re registered — {course.title}</h1>
          <p class="lead">Save this page or screenshot it. Bring your registration code to the venue for check-in.</p>
        </div>
      </section>

      <section class="section">
        <div class="wrap">
          <article class="card">
            <h2 style="font-size:1.1rem; margin-bottom:0.75rem;">Your batch</h2>
            <dl style="font-size:0.95rem; color:var(--muted); display:grid; grid-template-columns: 7rem 1fr; gap:0.4rem 1rem; margin-bottom:1rem;">
              <dt>Course</dt><dd>{course.title}</dd>
              <dt>When</dt><dd>{batchWhen(batch)}</dd>
              <dt>Where</dt><dd>{batchWhere(batch)}</dd>
              <dt>Fee</dt><dd>{Number(batch?.fee ?? 0) > 0 ? `₹${Number(batch?.fee)}${batch?.pay_on_spot ? ', pay on arrival' : ''}` : 'Free'}</dd>
              <dt>Registration code</dt>
              <dd style="font-weight:700; letter-spacing:0.08em; color:var(--purple-deep);">{reg_code}</dd>
            </dl>
            <p style="margin-bottom:1rem;">At the venue, give your registration code or mobile number at check-in. Once you’re marked present, your Certificate of Appreciation will be generated and emailed to you.</p>
            <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
              <a
                href={calendarUrl}
                class="btn btn--ghost btn--sm"
                target="_blank"
                rel="noopener"
              >
                Add to Google Calendar
              </a>
              <a href="/verify" class="btn btn--ghost btn--sm">Verify a certificate</a>
            </div>
          </article>
        </div>
      </section>
    </>
  )}
</Base>

<style>
  .page-head { padding-block: clamp(2rem, 6vw, 3.5rem) 1rem; }
  dl dd { margin: 0; color: var(--text); }
</style>
