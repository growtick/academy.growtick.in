---
import Base from '../layouts/Base.astro';
import { safeNext } from '../lib/http';

const next = safeNext(Astro.url.searchParams.get('next'));
if (Astro.locals.user) return Astro.redirect(next);
const isAdmin = next.startsWith('/admin');
const startOnSignup = Astro.url.searchParams.get('mode') === 'signup' && !isAdmin;
---
<Base title="Sign in — Growtick Academy" description="Sign in or create your Growtick Academy account." noindex={true}>
  <section class="section">
    <div class="wrap login">
      <p class="overline">{isAdmin ? 'Admin' : 'Account'}</p>
      <h1 id="title">{startOnSignup ? 'Create your account' : 'Sign in'}</h1>
      <p class="muted">Use the same email you registered for a batch with, and your registrations and certificates will show up in your dashboard.</p>

      <form id="signin-form" class="card stack-sm" data-api="/api/auth/password" hidden={startOnSignup}>
        <input type="hidden" name="next" value={next} />
        <label class="field"><span>Email</span><input type="email" name="email" required autocomplete="username" value={isAdmin ? 'admin@growtick.in' : ''} /></label>
        <label class="field"><span>Password</span><input type="password" name="password" required autocomplete="current-password" /></label>
        <button type="submit" class="btn">Sign in</button>
        <output class="form-msg"></output>
        {!isAdmin && <p class="small">New here? <a href="#" data-switch="signup">Create an account</a></p>}
        <p class="small muted">Forgot your password? Message us on <a href="https://wa.me/919513059059">WhatsApp</a> and we'll reset it.</p>
      </form>

      {!isAdmin && (
        <form id="signup-form" class="card stack-sm" data-api="/api/auth/signup" hidden={!startOnSignup}>
          <input type="hidden" name="next" value={next} />
          <label class="field"><span>Full name (printed on your certificates)</span><input name="full_name" required minlength="2" maxlength="80" autocomplete="name" /></label>
          <label class="field"><span>Email</span><input type="email" name="email" required autocomplete="email" /></label>
          <label class="field"><span>Choose a password (8+ characters)</span><input type="password" name="password" required minlength="8" autocomplete="new-password" /></label>
          <button type="submit" class="btn">Create account</button>
          <output class="form-msg"></output>
          <p class="small">Already have an account? <a href="#" data-switch="signin">Sign in</a></p>
        </form>
      )}

      <p class="small muted">Registering for an offline batch? No account needed. <a href="/courses">See courses →</a></p>
    </div>
  </section>
</Base>

<script>
  import '../scripts/api-forms';
  const signin = document.getElementById('signin-form') as HTMLFormElement;
  const signup = document.getElementById('signup-form') as HTMLFormElement | null;
  const title = document.getElementById('title')!;
  document.querySelectorAll<HTMLAnchorElement>('[data-switch]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const toSignup = a.dataset.switch === 'signup';
      signin.hidden = toSignup;
      if (signup) signup.hidden = !toSignup;
      title.textContent = toSignup ? 'Create your account' : 'Sign in';
      const url = new URL(location.href);
      if (toSignup) url.searchParams.set('mode', 'signup');
      else url.searchParams.delete('mode');
      history.replaceState(null, '', url);
      (toSignup ? signup : signin)?.querySelector<HTMLInputElement>('input:not([type=hidden])')?.focus();
    })
  );
</script>

<style>
  .login { max-width: 30rem; display: grid; gap: 1rem; }
  .login h1 { font-size: clamp(1.8rem, 5vw, 2.4rem); }
</style>
