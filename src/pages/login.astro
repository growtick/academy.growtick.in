---
import Base from '../layouts/Base.astro';
import { safeNext } from '../lib/http';

const error = Astro.url.searchParams.get('error');
const next = safeNext(Astro.url.searchParams.get('next'));
if (Astro.locals.user) return Astro.redirect(next);
const adminLogin = next.startsWith('/admin') || Astro.url.searchParams.get('mode') === 'password';
const ADMIN_EMAIL = 'admin@growtick.in';
---
<Base title="Sign in — Growtick Academy" description="Sign in to your Growtick Academy account." noindex={true}>
  <section class="section">
    <div class="wrap login">
      <p class="overline">Sign in</p>
      <h1>Sign in to Growtick Academy</h1>
      <p class="muted">We email you a sign-in link and a one-time code. No password needed. Use the same email you registered with and your past registrations and certificates will show up.</p>

      {error === 'not_configured' && <p class="notice">Sign-in isn't configured yet. Offline batches need no account: <a href="/courses">register for a batch</a>.</p>}
      {error === 'link' && <p class="notice">That sign-in link has expired or was already used. Request a new one below.</p>}

      <form id="password-form" class="card stack-sm" data-api="/api/auth/password" hidden={!adminLogin}>
        <strong>Sign in with password</strong>
        <input type="hidden" name="next" value={next} />
        <label class="field"><span>Email address</span><input type="email" name="email" required autocomplete="username" value={adminLogin ? ADMIN_EMAIL : ''} /></label>
        <label class="field"><span>Password</span><input type="password" name="password" required autocomplete="current-password" /></label>
        <button type="submit" class="btn">Sign in</button>
        <output class="form-msg"></output>
      </form>
      <p class="small"><a href="#" id="toggle-mode">{adminLogin ? 'Sign in with an email code instead' : 'Sign in with a password instead'}</a></p>

      <form id="email-form" class="card stack-sm" data-next={next} hidden={adminLogin} novalidate>
        <label class="field"><span>Email address</span><input type="email" name="email" required autocomplete="email" /></label>
        <button type="submit" class="btn">Email me a sign-in code</button>
        <p class="form-msg" role="status"></p>
      </form>

      <form id="code-form" class="card stack-sm" hidden novalidate>
        <p>We sent an email to <strong id="sent-to"></strong>. Click the link in it, or type the code here.</p>
        <label class="field"><span>Code</span><input name="token" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="10" required /></label>
        <button type="submit" class="btn">Sign in</button>
        <button type="button" class="btn btn--ghost btn--sm" id="change-email">Use a different email</button>
        <p class="form-msg" role="status"></p>
      </form>

      <p class="small muted">Registering for an offline batch? No account needed. <a href="/courses">See courses →</a></p>
    </div>
  </section>
</Base>

<script>
  import '../scripts/api-forms';
  const pwForm = document.getElementById('password-form') as HTMLFormElement;
  document.getElementById('toggle-mode')?.addEventListener('click', (e) => {
    e.preventDefault();
    const showPw = pwForm.hidden;
    pwForm.hidden = !showPw;
    (document.getElementById('email-form') as HTMLFormElement).hidden = showPw;
    (document.getElementById('code-form') as HTMLFormElement).hidden = true;
    (e.target as HTMLElement).textContent = showPw ? 'Sign in with an email code instead' : 'Sign in with a password instead';
  });
  const emailForm = document.getElementById('email-form') as HTMLFormElement;
  const next: string = emailForm.dataset.next || '/dashboard';
  const codeForm = document.getElementById('code-form') as HTMLFormElement;
  const say = (f: HTMLFormElement, t: string, kind = 'error') => {
    const m = f.querySelector<HTMLElement>('.form-msg')!;
    m.textContent = t;
    m.dataset.kind = kind;
  };
  let email = '';

  emailForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    email = String(new FormData(emailForm).get('email') ?? '').trim();
    if (!email.includes('@')) return say(emailForm, 'Enter a valid email address.');
    const btn = emailForm.querySelector('button')!;
    btn.disabled = true;
    say(emailForm, 'Sending…', 'ok');
    try {
      const res = await fetch('/api/auth/otp', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email, next }),
      });
      const data = await res.json();
      if (res.ok && data.ok) {
        emailForm.hidden = true;
        codeForm.hidden = false;
        document.getElementById('sent-to')!.textContent = email;
        codeForm.querySelector<HTMLInputElement>('input')!.focus();
      } else say(emailForm, data.error || 'Could not send the email. Try again.');
    } catch {
      say(emailForm, 'Network error. Try again.');
    }
    btn.disabled = false;
  });

  codeForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const token = String(new FormData(codeForm).get('token') ?? '').replace(/\D/g, '');
    if (token.length < 6) return say(codeForm, 'Enter the code from the email.');
    say(codeForm, 'Checking…', 'ok');
    try {
      const res = await fetch('/api/auth/verify', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email, token, next }),
      });
      const data = await res.json();
      if (res.ok && data.ok) location.href = data.redirect || next;
      else say(codeForm, data.error || 'Invalid code.');
    } catch {
      say(codeForm, 'Network error. Try again.');
    }
  });

  document.getElementById('change-email')!.addEventListener('click', () => {
    codeForm.hidden = true;
    emailForm.hidden = false;
  });
</script>

<style>
  .login { max-width: 30rem; display: grid; gap: 1rem; }
  .login h1 { font-size: clamp(1.8rem, 5vw, 2.4rem); }
</style>
