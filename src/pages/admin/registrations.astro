---
import Base from '../../layouts/Base.astro';
import { SUPABASE_URL } from 'astro:env/server';
import { serviceDb } from '../../lib/supabase';

export const prerender = false;

const db = serviceDb();
let rows: any[] = [];
let unconfigured = false;

if (db) {
  const { data } = await db
    .from('academy_enrollments')
    .select(`
      id, name, email, phone, reg_code, status, attended_at, created_at,
      academy_batches (venue, starts_at, ends_at, status, fee),
      academy_courses (title, slug),
      academy_certificates (serial, verify_code, pdf_path, issued_at, emailed_at)
    `)
    .order('created_at', { ascending: false });
  rows = data ?? [];
} else {
  unconfigured = true;
}

const pdfHost = (SUPABASE_URL ?? '').replace(/\/$/, '');
function pdfUrl(path: string | null) {
  return path ? `${pdfHost}/storage/v1/object/public/academy-certificates/${encodeURIComponent(path)}` : null;
}

function batchKey(b: any) {
  return b?.starts_at ? new Date(b.starts_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Batch';
}
function attended(a: string | null) {
  return a ? new Date(a).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '—';
}
---
<Base
  title="Admin — registrations · Growtick Academy"
  description="Check in attendees and issue certificates for the GST batch."
  noindex={true}
>
  <section class="section page-head">
    <div class="wrap">
      <p class="overline">Admin · Registrations</p>
      <h1>Batch registrations &amp; check-in</h1>
      <p class="lead">Mark attendees present as they arrive, then issue their Certificate of Appreciation. Certificates are generated as PDFs and emailed automatically.</p>
    </div>
  </section>

  {unconfigured ? (
    <section class="section">
      <div class="wrap">
        <div class="card">
          <p>Admin is not configured yet. Set <code>SUPABASE_URL</code> and <code>SUPABASE_SERVICE_ROLE_KEY</code> in the Cloudflare dashboard (or <code>.dev.vars</code> locally).</p>
        </div>
      </div>
    </section>
  ) : (
    <>
      <section class="section">
        <div class="wrap">
          <input
            id="admin-search"
            type="text"
            placeholder="Filter by name, email, phone or registration code…"
            style="width:100%; min-height:44px; padding:0.65rem 0.8rem; border:1px solid var(--border); border-radius:var(--radius); background:var(--surface-alt); color:var(--text); font:inherit; margin-bottom:1rem;"
          />
          <table style="width:100%; border-collapse:collapse; font-size:0.9rem;">
            <thead>
              <tr style="text-align:left; color:var(--muted); font-size:0.8rem;">
                <th style="padding:0.6rem 0.4rem; border-bottom:2px solid var(--border);">Attendee</th>
                <th style="padding:0.6rem 0.4rem; border-bottom:2px solid var(--border);">Batch</th>
                <th style="padding:0.6rem 0.4rem; border-bottom:2px solid var(--border);">Reg code</th>
                <th style="padding:0.6rem 0.4rem; border-bottom:2px solid var(--border);">Checked in</th>
                <th style="padding:0.6rem 0.4rem; border-bottom:2px solid var(--border);">Certificate</th>
                <th style="padding:0.6rem 0.4rem; border-bottom:2px solid var(--border); text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r: any) => {
                const cert = r.academy_certificates?.[0];
                const batch = r.academy_batches;
                const course = r.academy_courses;
                const done = !!r.attended_at;
                const issued = !!cert;
                return (
                  <tr id={`row-${r.id}`} style="border-bottom:1px solid var(--border);">
                    <td style="padding:0.7rem 0.4rem;">
                      <div style="font-weight:700; color:var(--ink);">{r.name}</div>
                      <div style="font-size:0.8rem; color:var(--muted);">{r.email}</div>
                      <div style="font-size:0.8rem; color:var(--muted);">{r.phone ?? '—'}</div>
                    </td>
                    <td style="padding:0.7rem 0.4rem; font-size:0.85rem; color:var(--muted);">
                      {course?.[0]?.title} · {batchKey(batch?.[0])}
                    </td>
                    <td style="padding:0.7rem 0.4rem; font-weight:700; letter-spacing:0.06em;">{r.reg_code}</td>
                    <td style="padding:0.7rem 0.4rem;">
                      {done ? (
                        <span style="color:var(--purple-deep); font-weight:700;">✓ {attended(r.attended_at)}</span>
                      ) : (
                        <span style="color:var(--muted);">—</span>
                      )}
                    </td>
                    <td style="padding:0.7rem 0.4rem;">
                      {issued ? (
                        <>
                          <div style="font-size:0.85rem; color:var(--purple-deep); font-weight:700;">Issued</div>
                          <div style="font-size:0.8rem; color:var(--muted); letter-spacing:0.06em;">{cert.serial}</div>
                          <a href={pdfUrl(cert.pdf_path)} target="_blank" rel="noopener" style="font-size:0.8rem; color:var(--purple-deep); text-decoration:underline;">PDF</a>
                        </>
                      ) : (
                        <span style="color:var(--muted);">Not issued</span>
                      )}
                    </td>
                    <td style="padding:0.7rem 0.4rem; text-align:right;">
                      {!done ? (
                        <button
                          data-action="checkin"
                          data-id={r.id}
                          class="btn btn--ghost btn--sm"
                          style="padding:0.35rem 0.8rem; font-size:0.8rem;"
                        >
                          Check in
                        </button>
                      ) : (
                        <span style="font-size:0.8rem; color:var(--purple-deep); font-weight:700;">Checked in</span>
                      )}
                      {!issued ? (
                        <button
                          data-action="issue"
                          data-id={r.id}
                          class="btn btn--sm"
                          style={done ? 'margin-left:0.4rem; padding:0.35rem 0.8rem; font-size:0.8rem;' : 'margin-left:0.4rem; padding:0.35rem 0.8rem; font-size:0.8rem; opacity:0.5;'}
                          disabled={!done}
                        >
                          Issue certificate
                        </button>
                      ) : (
                        <a href={pdfUrl(cert.pdf_path)} target="_blank" rel="noopener" class="btn btn--ghost btn--sm" style="padding:0.35rem 0.8rem; font-size:0.8rem;">Re-send PDF</a>
                      )}
                    </td>
                  </tr>
                );
              })}
              {rows.length === 0 && (
                <tr><td style="padding:1rem; text-align:center; color:var(--muted);" colspan="6">No registrations yet.</td></tr>
              )}
            </tbody>
          </table>
        </div>
      </section>
    </>
  )}
</Base>

<script>
  (() => {
    const search = document.getElementById('admin-search');
    const rows = document.querySelectorAll('tbody tr');

    if (search instanceof HTMLInputElement) {
      search.addEventListener('input', () => {
        const q = (search.value ?? '').toLowerCase();
        for (const r of rows) {
          if (!(r instanceof HTMLElement)) continue;
          const text = r.textContent?.toLowerCase() ?? '';
          r.style.display = text.includes(q) ? '' : 'none';
        }
      });
    }

    document.querySelectorAll('[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const kind = btn.getAttribute('data-action');
        const path = kind === 'checkin' ? '/api/admin/checkin' : '/api/certificates/issue';
        const res = await fetch(path, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ enrollment_id: id }),
        });
        const ok = await res.json();
        if (ok && ok.ok) {
          location.reload();
        } else {
          alert(ok && ok.error ? ok.error : 'Something went wrong.');
        }
      });
    });
  })();
</script>

<style>
  .page-head { padding-block: clamp(2rem, 6vw, 3.5rem) 1rem; }
  th { text-align: left; }
</style>
