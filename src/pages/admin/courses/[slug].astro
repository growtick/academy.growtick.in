---
import Admin from '../../../layouts/Admin.astro';
import { serviceDb } from '../../../lib/supabase';
import { batchWhen, many } from '../../../lib/http';

export const prerender = false;

const db = serviceDb();
const slug = Astro.params.slug ?? '';
if (!db) return new Response('Not configured', { status: 503 });

const { data: course } = await db
  .from('academy_courses')
  .select(
    `*, academy_batches (*),
     academy_modules (id, title, sort_order,
       academy_lessons (id, title, type, video_url, body, file_path, duration_min, is_preview, required, sort_order,
         academy_quiz_questions (id, prompt, options, correct_index, sort_order)))`
  )
  .eq('slug', slug)
  .maybeSingle();
if (!course) return new Response('Course not found', { status: 404 });

const byOrder = (a: any, b: any) => (a.sort_order ?? 0) - (b.sort_order ?? 0) || String(a.id).localeCompare(String(b.id));
const batches = many<any>(course.academy_batches).sort((a, b) => new Date(b.starts_at).getTime() - new Date(a.starts_at).getTime());
const modules = many<any>(course.academy_modules)
  .sort(byOrder)
  .map((m) => ({
    ...m,
    lessons: many<any>(m.academy_lessons)
      .sort(byOrder)
      .map((l) => ({ ...l, questions: many<any>(l.academy_quiz_questions).sort(byOrder) })),
  }));

const ist = (iso?: string | null) => (iso ? new Date(new Date(iso).getTime() + 5.5 * 3600_000).toISOString().slice(0, 16) : '');
const lines = (v: unknown) => (Array.isArray(v) ? v.join('\n') : '');
const api = '/api/admin/courses';
const body = (o: object) => JSON.stringify(o);
const types = [
  ['video', 'Video (YouTube)'],
  ['reading', 'Reading / notes'],
  ['download', 'Download (PDF, PPT…)'],
  ['quiz', 'Quiz'],
  ['live', 'Live class'],
];
---
<Admin title={course.title} heading={course.title} lead={`/${course.slug} · ${course.status}`}>
  <div class="row">
    <a class="btn btn--ghost btn--sm" href="/admin/courses">← All courses</a>
    <a class="btn btn--ghost btn--sm" href={`/courses/${course.slug}`} target="_blank">View page</a>
    {course.delivery !== 'offline' && <a class="btn btn--ghost btn--sm" href={`/learn/${course.slug}`} target="_blank">Open player</a>}
    <a class="btn btn--ghost btn--sm" href={`/api/admin/export?course=${course.slug}`}>Export CSV</a>
  </div>

  <!-- details -------------------------------------------------------------->
  <details class="card" open={modules.length === 0 && batches.length === 0}>
    <summary>Course details</summary>
    <form data-api={api} class="form-grid" data-keep>
      <input type="hidden" name="action" value="save_course" />
      <input type="hidden" name="original_slug" value={course.slug} />
      <input type="hidden" name="slug" value={course.slug} />
      <label class="field span-all"><span>Title</span><input name="title" required value={course.title} /></label>
      <label class="field span-all"><span>Subtitle</span><input name="subtitle" value={course.subtitle ?? ''} /></label>
      <label class="field span-all"><span>Description</span><textarea name="description" rows="4">{course.description ?? ''}</textarea></label>
      <label class="field"><span>Outcomes (one per line)</span><textarea name="outcomes" rows="4">{lines(course.outcomes)}</textarea></label>
      <label class="field"><span>Highlights (one per line)</span><textarea name="highlights" rows="4">{lines(course.highlights)}</textarea></label>
      <label class="field"><span>Delivery</span>
        <select name="delivery">
          {['offline', 'online', 'both'].map((d) => <option value={d} selected={course.delivery === d}>{d}</option>)}
        </select>
      </label>
      <label class="field"><span>Online price (₹, 0 = free)</span><input name="online_price" type="number" min="0" value={course.online_price ?? 0} /></label>
      <label class="field"><span>Certificate</span>
        <select name="certificate_kind">
          <option value="appreciation" selected={course.certificate_kind === 'appreciation'}>Appreciation</option>
          <option value="completion" selected={course.certificate_kind === 'completion'}>Completion</option>
        </select>
      </label>
      <label class="field"><span>Quiz pass mark (%)</span><input name="pass_mark" type="number" min="0" max="100" value={course.pass_mark} /></label>
      <label class="field"><span>Cover image URL</span><input name="cover_url" value={course.cover_url ?? ''} /></label>
      <label class="field"><span>Status</span>
        <select name="status">
          <option value="draft" selected={course.status === 'draft'}>Draft (hidden)</option>
          <option value="published" selected={course.status === 'published'}>Published</option>
        </select>
      </label>
      <div class="span-all row"><button class="btn btn--sm" type="submit">Save details</button><output class="form-msg"></output></div>
    </form>
    <form data-api="/api/admin/upload" class="row upload">
      <input type="hidden" name="target" value="cover" />
      <input type="hidden" name="course" value={course.slug} />
      <input type="file" name="file" accept="image/png,image/jpeg,image/webp" required />
      <button class="btn btn--ghost btn--sm" type="submit">Upload cover image</button>
      <output class="form-msg"></output>
    </form>
  </details>

  <!-- batches -------------------------------------------------------------->
  <h2 class="h3">Batches</h2>
  {batches.map((b) => (
    <details class="card">
      <summary>{b.kind === 'live' ? 'Live' : 'Offline'} · {batchWhen(b)} · <span class="badge">{b.status}</span></summary>
      <form data-api={api} class="form-grid">
        <input type="hidden" name="action" value="save_batch" />
        <input type="hidden" name="id" value={b.id} />
        <input type="hidden" name="course_id" value={course.slug} />
        <label class="field"><span>Type</span><select name="kind"><option value="offline" selected={b.kind === 'offline'}>Offline (venue)</option><option value="live" selected={b.kind === 'live'}>Live online class</option></select></label>
        <label class="field"><span>Starts (IST)</span><input type="datetime-local" name="starts_at" required value={ist(b.starts_at)} /></label>
        <label class="field"><span>Ends (IST)</span><input type="datetime-local" name="ends_at" required value={ist(b.ends_at)} /></label>
        <label class="field"><span>Status</span><select name="status">{['open', 'full', 'closed', 'done'].map((s) => <option value={s} selected={b.status === s}>{s}</option>)}</select></label>
        <label class="field"><span>Venue</span><input name="venue" value={b.venue ?? ''} /></label>
        <label class="field"><span>Address</span><input name="address" value={b.address ?? ''} /></label>
        <label class="field"><span>Map link</span><input name="map_url" value={b.map_url ?? ''} /></label>
        <label class="field"><span>Meeting link (live)</span><input name="meeting_url" value={b.meeting_url ?? ''} placeholder="https://meet.google.com/…" /></label>
        <label class="field"><span>Capacity (0 = unlimited)</span><input type="number" name="capacity" min="0" value={b.capacity} /></label>
        <label class="field"><span>Fee (₹)</span><input type="number" name="fee" min="0" value={b.fee} /></label>
        <label class="check"><input type="checkbox" name="pay_on_spot" checked={b.pay_on_spot} /> Pay on the spot</label>
        <div class="span-all row">
          <button class="btn btn--sm" type="submit">Save batch</button>
          <a class="btn btn--ghost btn--sm" href={`/admin/registrations?batch=${b.id}`}>Registrations</a>
          <button class="btn btn--ghost btn--sm danger" type="button" data-api={api} data-body={body({ action: 'delete_batch', id: b.id })} data-confirm="Delete this batch?">Delete</button>
          <output class="form-msg"></output>
        </div>
      </form>
    </details>
  ))}
  <details class="card">
    <summary>+ Add batch</summary>
    <form data-api={api} class="form-grid">
      <input type="hidden" name="action" value="save_batch" />
      <input type="hidden" name="course_id" value={course.slug} />
      <label class="field"><span>Type</span><select name="kind"><option value="offline">Offline (venue)</option><option value="live">Live online class</option></select></label>
      <label class="field"><span>Starts (IST)</span><input type="datetime-local" name="starts_at" required /></label>
      <label class="field"><span>Ends (IST)</span><input type="datetime-local" name="ends_at" required /></label>
      <input type="hidden" name="status" value="open" />
      <label class="field"><span>Venue</span><input name="venue" /></label>
      <label class="field"><span>Address</span><input name="address" /></label>
      <label class="field"><span>Map link</span><input name="map_url" /></label>
      <label class="field"><span>Meeting link (live)</span><input name="meeting_url" /></label>
      <label class="field"><span>Capacity (0 = unlimited)</span><input type="number" name="capacity" min="0" value="0" /></label>
      <label class="field"><span>Fee (₹)</span><input type="number" name="fee" min="0" value="0" /></label>
      <label class="check"><input type="checkbox" name="pay_on_spot" checked /> Pay on the spot</label>
      <div class="span-all row"><button class="btn btn--sm" type="submit">Add batch</button><output class="form-msg"></output></div>
    </form>
  </details>

  <!-- curriculum ----------------------------------------------------------->
  <h2 class="h3">Curriculum</h2>
  {course.delivery === 'offline' && <p class="small muted">This course is offline-only; the curriculum is shown as an outline on the course page. Switch delivery to online or both to sell it online.</p>}

  {modules.map((m, mi) => (
    <section class="card module stack-sm">
      <div class="row row--between">
        <form data-api={api} class="row grow">
          <input type="hidden" name="action" value="save_module" />
          <input type="hidden" name="id" value={m.id} />
          <input type="hidden" name="course_id" value={course.slug} />
          <span class="muted small">Module {mi + 1}</span>
          <input class="input grow" name="title" value={m.title} required aria-label="Module title" />
          <button class="btn btn--ghost btn--sm" type="submit">Rename</button>
        </form>
        <span class="row">
          <button class="btn btn--ghost btn--sm" data-api={api} data-body={body({ action: 'move', table: 'module', id: m.id, dir: 'up' })} aria-label="Move module up">↑</button>
          <button class="btn btn--ghost btn--sm" data-api={api} data-body={body({ action: 'move', table: 'module', id: m.id, dir: 'down' })} aria-label="Move module down">↓</button>
          <button class="btn btn--ghost btn--sm danger" data-api={api} data-body={body({ action: 'delete_module', id: m.id })} data-confirm={`Delete module "${m.title}" and all its lessons?`}>Delete</button>
        </span>
      </div>

      {m.lessons.map((l: any, li: number) => (
        <details class="lesson">
          <summary>
            <span class="badge">{l.type}</span> {mi + 1}.{li + 1} {l.title}
            {l.is_preview && <span class="badge badge--ok">preview</span>}
            {!l.required && <span class="badge">optional</span>}
            {l.type === 'quiz' && <span class="badge">{l.questions.length} q</span>}
            {l.file_path && <span class="badge">file</span>}
          </summary>
          <div class="stack-sm lesson__body">
            <form data-api={api} class="form-grid">
              <input type="hidden" name="action" value="save_lesson" />
              <input type="hidden" name="id" value={l.id} />
              <input type="hidden" name="module_id" value={m.id} />
              <label class="field"><span>Title</span><input name="title" required value={l.title} /></label>
              <label class="field"><span>Type</span><select name="type">{types.map(([v, t]) => <option value={v} selected={l.type === v}>{t}</option>)}</select></label>
              <label class="field"><span>YouTube URL (video)</span><input name="video_url" value={l.video_url ?? ''} placeholder="https://youtu.be/…" /></label>
              <label class="field"><span>Duration (min)</span><input type="number" name="duration_min" min="0" value={l.duration_min ?? ''} /></label>
              <label class="field span-all"><span>Text / notes (blank line = new paragraph)</span><textarea name="body" rows="5">{l.body ?? ''}</textarea></label>
              <div class="span-all row">
                <label class="check"><input type="checkbox" name="required" checked={l.required} /> Required for certificate</label>
                <label class="check"><input type="checkbox" name="is_preview" checked={l.is_preview} /> Free preview</label>
              </div>
              <div class="span-all row">
                <button class="btn btn--sm" type="submit">Save lesson</button>
                <button class="btn btn--ghost btn--sm" type="button" data-api={api} data-body={body({ action: 'move', table: 'lesson', id: l.id, dir: 'up' })}>↑</button>
                <button class="btn btn--ghost btn--sm" type="button" data-api={api} data-body={body({ action: 'move', table: 'lesson', id: l.id, dir: 'down' })}>↓</button>
                <button class="btn btn--ghost btn--sm danger" type="button" data-api={api} data-body={body({ action: 'delete_lesson', id: l.id })} data-confirm="Delete this lesson?">Delete</button>
                <output class="form-msg"></output>
              </div>
            </form>

            <form data-api="/api/admin/upload" class="row upload">
              <input type="hidden" name="target" value="lesson" />
              <input type="hidden" name="lesson_id" value={l.id} />
              <span class="small muted">{l.file_path ? `File: ${l.file_path.split('/').pop()}` : 'No file attached'}</span>
              <input type="file" name="file" required />
              <button class="btn btn--ghost btn--sm" type="submit">{l.file_path ? 'Replace file' : 'Attach file'}</button>
              <output class="form-msg"></output>
            </form>

            {l.type === 'quiz' && (
              <div class="stack-sm quiz">
                <strong class="small">Questions</strong>
                {l.questions.map((q: any, qi: number) => (
                  <form data-api={api} class="form-grid q">
                    <input type="hidden" name="action" value="save_question" />
                    <input type="hidden" name="id" value={q.id} />
                    <input type="hidden" name="lesson_id" value={l.id} />
                    <label class="field span-all"><span>Q{qi + 1}</span><input name="prompt" required value={q.prompt} /></label>
                    <label class="field"><span>Options (one per line)</span><textarea name="options" rows="4" required>{lines(q.options)}</textarea></label>
                    <label class="field"><span>Correct option #</span><input type="number" name="correct_index" min="1" required value={(q.correct_index ?? 0) + 1} /></label>
                    <div class="span-all row">
                      <button class="btn btn--ghost btn--sm" type="submit">Save</button>
                      <button class="btn btn--ghost btn--sm" type="button" data-api={api} data-body={body({ action: 'move', table: 'question', id: q.id, dir: 'up' })}>↑</button>
                      <button class="btn btn--ghost btn--sm" type="button" data-api={api} data-body={body({ action: 'move', table: 'question', id: q.id, dir: 'down' })}>↓</button>
                      <button class="btn btn--ghost btn--sm danger" type="button" data-api={api} data-body={body({ action: 'delete_question', id: q.id })} data-confirm="Delete this question?">Delete</button>
                      <output class="form-msg"></output>
                    </div>
                  </form>
                ))}
                <form data-api={api} class="form-grid q q--new">
                  <input type="hidden" name="action" value="save_question" />
                  <input type="hidden" name="lesson_id" value={l.id} />
                  <label class="field span-all"><span>New question</span><input name="prompt" required /></label>
                  <label class="field"><span>Options (one per line)</span><textarea name="options" rows="4" required></textarea></label>
                  <label class="field"><span>Correct option #</span><input type="number" name="correct_index" min="1" required value="1" /></label>
                  <div class="span-all row"><button class="btn btn--sm" type="submit">Add question</button><output class="form-msg"></output></div>
                </form>
              </div>
            )}
          </div>
        </details>
      ))}

      <details class="lesson">
        <summary>+ Add lesson</summary>
        <form data-api={api} class="form-grid lesson__body">
          <input type="hidden" name="action" value="save_lesson" />
          <input type="hidden" name="module_id" value={m.id} />
          <label class="field"><span>Title</span><input name="title" required /></label>
          <label class="field"><span>Type</span><select name="type">{types.map(([v, t]) => <option value={v}>{t}</option>)}</select></label>
          <label class="field"><span>YouTube URL (video)</span><input name="video_url" /></label>
          <label class="field"><span>Duration (min)</span><input type="number" name="duration_min" min="0" /></label>
          <label class="field span-all"><span>Text / notes</span><textarea name="body" rows="3"></textarea></label>
          <div class="span-all row">
            <label class="check"><input type="checkbox" name="required" checked /> Required for certificate</label>
            <label class="check"><input type="checkbox" name="is_preview" /> Free preview</label>
          </div>
          <div class="span-all row"><button class="btn btn--sm" type="submit">Add lesson</button><output class="form-msg"></output></div>
        </form>
      </details>
    </section>
  ))}

  <form data-api={api} class="card row">
    <input type="hidden" name="action" value="save_module" />
    <input type="hidden" name="course_id" value={course.slug} />
    <input class="input grow" name="title" required placeholder="New module title, e.g. Module 1: GST basics" aria-label="New module title" />
    <button class="btn btn--sm" type="submit">Add module</button>
    <output class="form-msg"></output>
  </form>
</Admin>

<style>
  .h3 { font-size: 1.2rem; margin: 0.75rem 0 0; }
  .grow { flex: 1; min-width: min(100%, 12rem); }
  .module { padding: 1rem; }
  .lesson { border: 1px solid var(--border); border-radius: 12px; background: var(--surface-alt); padding: 0.6rem 0.8rem; }
  .lesson > summary { cursor: pointer; display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap; font-weight: 600; }
  .lesson__body { padding-top: 0.8rem; }
  .upload { border-top: 1px dashed var(--border); padding-top: 0.6rem; margin-top: 0.4rem; }
  .quiz { border-top: 1px dashed var(--border); padding-top: 0.6rem; }
  .q { border: 1px solid var(--border); border-radius: 10px; padding: 0.7rem; }
  .q--new { border-style: dashed; }
  .danger { color: var(--accent); }
</style>
