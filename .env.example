# Copy to .env for local dev (never commit .env). In production set these as
# Cloudflare Worker variables/secrets.
#
# Needed before launch: Supabase project (same as growtick.in or a new one,
# tables are prefixed `academy_` either way), Resend with growtick.in verified
# as a sending domain, Turnstile keys, and admin email addresses.

# Public (browser-safe)
PUBLIC_SITE_URL=http://localhost:4321

# Supabase (Project settings → API)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Server secrets (never shipped to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (invisible CAPTCHA) — reuse growtick.in's widget
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAF1oJauByyrcQjqK
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Resend — sending domain growtick.in verified, from address academy@growtick.in
RESEND_API_KEY=
RESEND_FROM=Growtick Academy <academy@growtick.in>
